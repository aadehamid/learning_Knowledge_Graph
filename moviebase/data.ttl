# :_review2 concepts:rating 4 ;
#           concepts:reviewText "A visually impressive film with a strong cast, though the pacing can be slow at times."@en ;
# .

data:OrlandoBloom rdf:type concepts:Actor ;
                      concepts:isFrom data:UK ;
                      concepts:actsAs data:Balian ;
.
data:Balian rdf:type concepts:Blacksmith .
