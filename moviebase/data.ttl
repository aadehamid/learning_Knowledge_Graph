@prefix data:<https://mymovies.com/data#> .
@prefix concepts:<https://mymovies.com/concepts#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:KingdomOfHeaven  rdf:type concepts:movie ;
                      concepts:hasRole data:Balian ,
                                       data:Sybilla ,
                                       data:Baldwin ,
                                       data:Saladin ;
                      concepts:hasActor  data:OrlandoBloom ;
                      concepts:releaseYear "2005"^^xsd:integer;
                      concepts:originalLanguage "English"^^xsd:string ;
                      concepts:originalDuration "138"^^xsd:integer; #minutes
                      concepts:title "Kingdom of Heaven"@en ,
                      "Le Royaume de Dieu"@fr ,
                      "Reino de Dios"@es ;
                    #   concepts:hasReview _:review1 ,
                    #                      _:review2 ;
                      concepts:hasReview [
                        concepts:rating "5"^^xsd:integer;
                        concepts:reviewText "An epic historical drama with stunning visuals and a compelling story."@en];
                      concepts:hasReview [
                        concepts:rating "4"^^xsd:integer;
                        concepts:reviewText "A visually impressive film with a strong cast, though the pacing can be slow at times."@en;
                        concepts:reviewComments [
                            concepts:reviewCommentsText "Some minor pacing issues, but overall a strong film."@en]
                        ];
.

# unnested blank node
